@page "/"
@inject ShelfLifeApiClient Api
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>ShelfLife — Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div class="d-flex flex-column align-center mb-8" style="text-align: center;">
        <MudText Typo="Typo.h3" Style="font-weight: 700; background: linear-gradient(135deg, #7C4DFF, #448AFF); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            Welcome to ShelfLife
        </MudText>
        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">
            Track your reading journey, discover new books, and never lose a recommendation again.
        </MudText>
    </div>

    @if (_loading)
    {
        <MudGrid Spacing="4">
            @for (var i = 0; i < 4; i++)
            {
                <MudItem xs="6" sm="3">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudGrid Spacing="4" Class="mb-8">
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="3" Class="pa-4 d-flex flex-column align-center" Style="border-radius: 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h4" Class="mt-2" Style="font-weight: 700;">@(_stats?.TotalBooks ?? 0)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Books</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="3" Class="pa-4 d-flex flex-column align-center" Style="border-radius: 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Large" Color="Color.Warning" />
                    <MudText Typo="Typo.h4" Class="mt-2" Style="font-weight: 700;">@(_stats?.CurrentlyReading ?? 0)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Currently Reading</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="3" Class="pa-4 d-flex flex-column align-center" Style="border-radius: 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                    <MudText Typo="Typo.h4" Class="mt-2" Style="font-weight: 700;">@(_stats?.BooksFinished ?? 0)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Finished</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="3" Class="pa-4 d-flex flex-column align-center" Style="border-radius: 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Large" Color="Color.Info" />
                    <MudText Typo="Typo.h4" Class="mt-2" Style="font-weight: 700;">@(_stats?.AverageRating.ToString("0.0") ?? "—")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Avg Rating</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (_currentlyReading.Count > 0)
        {
            <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 600;">📖 Currently Reading</MudText>
            <MudGrid Spacing="4" Class="mb-8">
                @foreach (var book in _currentlyReading)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <ShelfLife.Web.Components.Shared.BookCard Book="book" OnViewDetails="NavigateToBook" />
                    </MudItem>
                }
            </MudGrid>
        }

        @if (_stats?.TotalBooks == 0)
        {
            <div class="d-flex flex-column align-center mt-8">
                <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-4">
                    Your shelf is empty! Search for books to get started.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="@(() => Navigation.NavigateTo("/search"))">
                    Find Books
                </MudButton>
            </div>
        }
    }
</MudContainer>

@code {
    private ReadingStatsDto? _stats;
    private List<BookDto> _currentlyReading = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Api.SeedBooksAsync();
            _stats = await Api.GetStatsAsync();
            _currentlyReading = await Api.GetBooksAsync(ReadingStatus.Reading);
        }
        catch
        {
            Snackbar.Add("Could not connect to the API. Is the backend running?", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }



    private void NavigateToBook(int id)
    {
        Navigation.NavigateTo($"/book/{id}");
    }
}
