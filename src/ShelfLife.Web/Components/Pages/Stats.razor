@page "/stats"
@inject ShelfLifeApiClient Api
@inject ISnackbar Snackbar

<PageTitle>ShelfLife — Stats</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700;">📊 Reading Stats</MudText>

    @if (_loading)
    {
        <MudGrid Spacing="4">
            @for (var i = 0; i < 5; i++)
            {
                <MudItem xs="6" sm="4" md="2">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (_stats is null)
    {
        <div class="d-flex flex-column align-center mt-8">
            <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">
                Could not load stats. Is the backend running?
            </MudText>
        </div>
    }
    else
    {
        <MudGrid Spacing="4" Class="mb-8">
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Elevation="3" Class="pa-4 d-flex flex-column align-center" Style="border-radius: 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Color="Color.Primary" />
                    <MudText Typo="Typo.h5" Class="mt-1" Style="font-weight: 700;">@_stats.TotalBooks</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Elevation="3" Class="pa-4 d-flex flex-column align-center" Style="border-radius: 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.AutoStories" Color="Color.Warning" />
                    <MudText Typo="Typo.h5" Class="mt-1" Style="font-weight: 700;">@_stats.CurrentlyReading</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Reading</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Elevation="3" Class="pa-4 d-flex flex-column align-center" Style="border-radius: 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                    <MudText Typo="Typo.h5" Class="mt-1" Style="font-weight: 700;">@_stats.BooksFinished</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Finished</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Elevation="3" Class="pa-4 d-flex flex-column align-center" Style="border-radius: 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Info" />
                    <MudText Typo="Typo.h5" Class="mt-1" Style="font-weight: 700;">@_stats.AverageRating.ToString("0.0")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Avg Rating</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Elevation="3" Class="pa-4 d-flex flex-column align-center" Style="border-radius: 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Secondary" />
                    <MudText Typo="Typo.h5" Class="mt-1" Style="font-weight: 700;">@_stats.TotalPagesRead.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Pages Read</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (_monthLabels.Length > 0)
        {
            <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 600;">📅 Books Finished Per Month</MudText>
            <MudPaper Elevation="3" Class="pa-4 mb-8" Style="border-radius: 16px;">
                <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@_monthSeries"
                          ChartLabels="@_monthLabels" Width="100%" Height="300px"
                          ChartOptions="@_barOptions" />
            </MudPaper>
        }

        @if (_genreLabels.Length > 0)
        {
            <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 600;">📖 Books by Genre</MudText>
            <MudPaper Elevation="3" Class="pa-4 mb-8" Style="border-radius: 16px;">
                <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@_genreSeries"
                          ChartLabels="@_genreLabels" Width="300px" Height="300px"
                          LegendPosition="Position.Right" />
            </MudPaper>
        }

        <MudPaper Elevation="3" Class="pa-6 d-flex flex-column align-center" Style="border-radius: 16px; background: linear-gradient(135deg, #7C4DFF 0%, #448AFF 100%);">
            <MudText Typo="Typo.h3" Style="font-weight: 800; color: white;">
                @_stats.TotalPagesRead.ToString("N0")
            </MudText>
            <MudText Typo="Typo.h6" Style="color: rgba(255,255,255,0.8);">
                Total Pages Read 🎉
            </MudText>
            @if (_stats.TotalPagesRead > 0)
            {
                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.6);" Class="mt-1">
                    That's roughly @((_stats.TotalPagesRead / 250).ToString("N0")) full-length novels!
                </MudText>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    private ReadingStatsDto? _stats;
    private bool _loading = true;

    private List<ChartSeries<double>> _monthSeries = [];
    private string[] _monthLabels = [];
    private List<ChartSeries<double>> _genreSeries = [];
    private string[] _genreLabels = [];
    private readonly BarChartOptions _barOptions = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _stats = await Api.GetStatsAsync();
            if (_stats is not null)
            {
                BuildChartData();
            }
        }
        catch
        {
            Snackbar.Add("Could not load stats. Is the backend running?", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildChartData()
    {
        if (_stats is null) return;

        // Books per month
        if (_stats.BooksPerMonth.Count > 0)
        {
            _monthLabels = _stats.BooksPerMonth.Keys.ToArray();
            var monthData = _stats.BooksPerMonth.Values.Select(v => (double)v).ToArray();
            _monthSeries = [new ChartSeries<double> { Name = "Books Finished", Data = monthData }];
        }

        // Genre distribution
        if (_stats.BooksByGenre.Count > 0)
        {
            _genreLabels = _stats.BooksByGenre.Keys.ToArray();
            var genreData = _stats.BooksByGenre.Values.Select(v => (double)v).ToArray();
            _genreSeries = [new ChartSeries<double> { Name = "Genre", Data = genreData }];
        }
    }
}
