@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="4" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2" Style="font-weight: 700; letter-spacing: 0.5px;">
            ShelfLife 📚
        </MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="ToggleTheme" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2"
               Variant="@DrawerVariant.Mini" OpenMiniOnHover="true">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                Home
            </MudNavLink>
            <MudNavLink Href="/search" Icon="@Icons.Material.Filled.Search">
                Search
            </MudNavLink>
            <MudNavLink Href="/shelf" Icon="@Icons.Material.Filled.LibraryBooks">
                My Shelf
            </MudNavLink>
            <MudNavLink Href="/stats" Icon="@Icons.Material.Filled.BarChart">
                Stats
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pt-16 pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#7C4DFF",
            Secondary = "#448AFF",
            AppbarBackground = "#7C4DFF",
            Background = "#f5f5f9",
            Surface = "#ffffff"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#7C4DFF",
            Secondary = "#448AFF",
            Background = "#1a1a2e",
            Surface = "#16213e",
            AppbarBackground = "#0f3460",
            DrawerBackground = "#16213e",
            TextPrimary = "#e0e0e0",
            TextSecondary = "#a0a0b0"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Roboto", "Helvetica", "Arial", "sans-serif"] }
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleTheme() => _isDarkMode = !_isDarkMode;
}
